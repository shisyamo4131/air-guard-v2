rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model (OUT-02 scoped addition)
    // ===============================================================
    // Companies/{companyId}/Outsourcers/{docId}
    // - immutable identity: docId (string, path match), createdAt (timestamp)
    // - write metadata: uid (current actor), updatedAt (request time)
    // - nullable strings: code (10), remarks (200)
    // - required strings: name (20), nameKana (40), displayName (6)
    // - contractStatus: ACTIVE or TERMINATED; create is ACTIVE
    // - tokenMap: nullable map, max 512 boolean-true entries
    // Outsourcers_archive remains client-read-only within the same tenant.

    // --- Helper Functions (Optional, but good for clarity) ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasValidIdentityClaims() {
      return isAuthenticated()
        && request.auth.token.email_verified is bool
        && request.auth.token.email_verified == true
        && request.auth.token.companyId is string
        && request.auth.token.companyId.size() > 0;
    }

    function hasActiveRegisteredUser() {
      return hasValidIdentityClaims()
        && exists(/databases/$(database)/documents/Companies/$(request.auth.token.companyId)/Users/$(request.auth.uid))
        && get(/databases/$(database)/documents/Companies/$(request.auth.token.companyId)/Users/$(request.auth.uid)).data.companyId is string
        && get(/databases/$(database)/documents/Companies/$(request.auth.token.companyId)/Users/$(request.auth.uid)).data.companyId == request.auth.token.companyId
        && get(/databases/$(database)/documents/Companies/$(request.auth.token.companyId)/Users/$(request.auth.uid)).data.isTemporary is bool
        && get(/databases/$(database)/documents/Companies/$(request.auth.token.companyId)/Users/$(request.auth.uid)).data.isTemporary == false
        && get(/databases/$(database)/documents/Companies/$(request.auth.token.companyId)/Users/$(request.auth.uid)).data.disabled is bool
        && get(/databases/$(database)/documents/Companies/$(request.auth.token.companyId)/Users/$(request.auth.uid)).data.disabled == false;
    }

    function userCompanyId() {
      return hasActiveRegisteredUser()
        ? request.auth.token.companyId
        : "";
    }

    function isSafeIdentifier(value) {
      return value is string && value.size() > 0 && value.size() <= 128;
    }

    function isSafeCustomerId(value) {
      return isSafeIdentifier(value) && value.matches('^[^/]+$');
    }

    function customerExists(companyId, customerId) {
      return isSafeCustomerId(customerId)
        && exists(/databases/$(database)/documents/Companies/$(companyId)/Customers/$(customerId));
    }

    function hasExistingCustomerReference(companyId, data) {
      return data.keys().hasAll(['customerId'])
        && customerExists(companyId, data.customerId);
    }

    function hasUnsetCustomerReference(data) {
      return !data.keys().hasAny(['customerId']) || data.customerId == null;
    }

    function isValidOptionalCustomerReferenceCreate(companyId) {
      return hasUnsetCustomerReference(request.resource.data)
        || hasExistingCustomerReference(companyId, request.resource.data);
    }

    function isValidCustomerReferenceCreate(companyId) {
      return hasExistingCustomerReference(companyId, request.resource.data);
    }

    function isValidCustomerReferenceUpdate(companyId) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['customerId'])
        || hasExistingCustomerReference(companyId, request.resource.data);
    }

    function isValidOptionalCustomerReferenceUpdate(companyId) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['customerId'])
        || (hasUnsetCustomerReference(resource.data)
          && hasUnsetCustomerReference(request.resource.data))
        || hasExistingCustomerReference(companyId, request.resource.data);
    }

    function isValidFcmTokenCreate(token) {
      return hasActiveRegisteredUser()
        && request.resource.data.keys().hasOnly([
          'token', 'uid', 'companyId', 'updatedAt'
        ])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.token.size() <= 4096
        && request.resource.data.token == token
        && isSafeIdentifier(request.resource.data.uid)
        && request.resource.data.uid == request.auth.uid
        && isSafeIdentifier(request.resource.data.companyId)
        && request.resource.data.companyId == request.auth.token.companyId
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidActiveEmployeeCreate() {
      return request.resource.data.employmentStatus is string
        && request.resource.data.employmentStatus == 'ACTIVE'
        && (!request.resource.data.keys().hasAny(['dateOfTermination'])
          || request.resource.data.dateOfTermination == null)
        && (!request.resource.data.keys().hasAny(['reasonOfTermination'])
          || request.resource.data.reasonOfTermination == null);
    }

    function preservesEmployeeLifecycleFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'employmentStatus', 'dateOfTermination', 'reasonOfTermination'
      ]);
    }

    function isNullableString(value, maxSize) {
      return value == null || (value is string && value.size() <= maxSize);
    }

    function isRequiredString(value, maxSize) {
      return value is string && value.size() > 0 && value.size() <= maxSize;
    }

    function isValidCustomerLocation(value) {
      return value == null
        || (value is map
          && value.keys().hasAll(['formattedAddress', 'lat', 'lng'])
          && value.keys().hasOnly(['formattedAddress', 'lat', 'lng'])
          && isRequiredString(value.formattedAddress, 200)
          && value.lat is number
          && value.lat >= -90
          && value.lat <= 90
          && value.lng is number
          && value.lng >= -180
          && value.lng <= 180);
    }

    function isValidCustomerTokenMap(value) {
      return value == null
        || (value is map
          && value.size() <= 512
          && value.values().hasOnly([true]));
    }

    function isValidCustomer(data, docId) {
      return data.keys().size() == 26
        && isRequiredString(data.docId, 128)
        && data.docId == docId
        && isRequiredString(data.uid, 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && isNullableString(data.code, 10)
        && isRequiredString(data.name, 20)
        && isNullableString(data.branchName, 20)
        && isRequiredString(data.abbreviation, 20)
        && isRequiredString(data.nameKana, 40)
        && data.zipcode is string
        && data.zipcode.size() > 0
        && data.prefCode is string
        && data.prefCode.matches('^(0[1-9]|[1-3][0-9]|4[0-7])$')
        && isRequiredString(data.city, 20)
        && isRequiredString(data.address, 30)
        && isNullableString(data.building, 30)
        && isValidCustomerLocation(data.location)
        && ((data.location == null && data.geopoint == null)
          || (data.location is map
            && data.geopoint is latlng
            && data.geopoint.latitude() == data.location.lat
            && data.geopoint.longitude() == data.location.lng))
        && isNullableString(data.tel, 13)
        && isNullableString(data.fax, 13)
        && data.contractStatus in ['ACTIVE', 'TERMINATED']
        && data.cutoffDate is int
        && data.cutoffDate in [0, 5, 10, 15, 20, 25]
        && data.paymentMonth is int
        && data.paymentMonth in [0, 1, 2, 3, 4, 5, 6]
        && data.paymentDate is int
        && data.paymentDate in [0, 5, 10, 15, 20, 25]
        && isNullableString(data.remarks, 200)
        && isRequiredString(data.fullAddress, 74)
        && isRequiredString(data.prefecture, 4)
        && data.fullAddress == data.prefecture + data.city + data.address
        && isValidCustomerTokenMap(data.tokenMap);
    }

    function hasCustomerWriteRole(user) {
      return user.roles is list
        && user.roles.size() <= 6
        && user.roles.hasOnly([
          'manager', 'controller', 'accountant',
          'human-resource', 'labor', 'legal'
        ])
        && user.roles.hasAny(['manager', 'legal']);
    }

    function canWriteCustomer(companyId) {
      let user = get(/databases/$(database)/documents/Companies/$(companyId)/Users/$(request.auth.uid)).data;
      return hasValidIdentityClaims()
        && request.auth.token.companyId == companyId
        && exists(/databases/$(database)/documents/Companies/$(companyId)/Users/$(request.auth.uid))
        && user.companyId is string
        && user.companyId == companyId
        && user.isTemporary is bool
        && user.isTemporary == false
        && user.disabled is bool
        && user.disabled == false
        && request.auth.token.isSuperUser is bool
        && user.isAdmin is bool
        && (user.isAdmin == true
          || (request.auth.token.isSuperUser == false
            && hasCustomerWriteRole(user)));
    }

    function hasSiteWriteRole(user) {
      return user.roles is list
        && user.roles.size() <= 6
        && user.roles.hasOnly([
          'manager', 'controller', 'accountant',
          'human-resource', 'labor', 'legal'
        ])
        && user.roles.hasAny(['manager', 'controller', 'legal']);
    }

    function isActiveSiteWriter(companyId, user) {
      return user.companyId is string
        && user.companyId == companyId
        && user.isTemporary is bool
        && user.isTemporary == false
        && user.disabled is bool
        && user.disabled == false
        && user.isAdmin is bool
        && (user.isAdmin == true
          || (request.auth.token.isSuperUser == false
            && hasSiteWriteRole(user)));
    }

    function canWriteSite(companyId) {
      let userPath = /databases/$(database)/documents/Companies/$(companyId)/Users/$(request.auth.uid);
      return hasValidIdentityClaims()
        && request.auth.token.companyId == companyId
        && request.auth.token.isSuperUser is bool
        && isActiveSiteWriter(companyId, get(userPath).data);
    }

    function hasExactOutsourcerManagerRole(user) {
      return user.keys().hasAll(['roles'])
        ? (user.roles is list
          ? (user.roles.size() == 1
            ? user.roles[0] == 'manager'
            : false)
          : false)
        : false;
    }

    function hasValidOutsourcerIdentityClaims(companyId) {
      return isAuthenticated()
        ? (request.auth.token.keys().hasAll(['email_verified', 'companyId', 'isSuperUser'])
          ? (request.auth.token.companyId is string
            ? request.auth.token.email_verified is bool
              && request.auth.token.email_verified == true
              && request.auth.token.companyId.size() > 0
              && request.auth.token.companyId == companyId
              && request.auth.token.isSuperUser is bool
            : false)
          : false)
        : false;
    }

    function isActiveOutsourcerWriter(companyId, user) {
      return user.keys().hasAll(['companyId', 'isTemporary', 'disabled', 'isAdmin'])
        ? user.companyId is string
          && user.companyId == companyId
          && user.isTemporary is bool
          && user.isTemporary == false
          && user.disabled is bool
          && user.disabled == false
          && user.isAdmin is bool
          && (user.isAdmin == true
            || (request.auth.token.isSuperUser == false
              && hasExactOutsourcerManagerRole(user)))
        : false;
    }

    function canWriteOutsourcer(companyId) {
      let userPath = /databases/$(database)/documents/Companies/$(companyId)/Users/$(request.auth.uid);
      return hasValidOutsourcerIdentityClaims(companyId)
        && exists(userPath)
        && isActiveOutsourcerWriter(companyId, get(userPath).data);
    }

    function isValidOutsourcerTokenMap(value) {
      return value == null
        || (value is map
          && value.size() <= 512
          && value.values().hasOnly([true]));
    }

    function isValidOutsourcer(data, docId) {
      return data.keys().hasAll([
          'docId', 'uid', 'createdAt', 'updatedAt', 'code', 'name',
          'nameKana', 'displayName', 'contractStatus', 'remarks', 'tokenMap'
        ])
        && data.keys().hasOnly([
          'docId', 'uid', 'createdAt', 'updatedAt', 'code', 'name',
          'nameKana', 'displayName', 'contractStatus', 'remarks', 'tokenMap'
        ])
        && isRequiredString(data.docId, 128)
        && data.docId == docId
        && isRequiredString(data.uid, 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && isNullableString(data.code, 10)
        && isRequiredString(data.name, 20)
        && isRequiredString(data.nameKana, 40)
        && isRequiredString(data.displayName, 6)
        && data.contractStatus in ['ACTIVE', 'TERMINATED']
        && isNullableString(data.remarks, 200)
        && isValidOutsourcerTokenMap(data.tokenMap);
    }

    function isValidOutsourcerCreate(docId) {
      return isValidOutsourcer(request.resource.data, docId)
        && request.resource.data.contractStatus == 'ACTIVE'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidOutsourcerUpdate(docId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let businessFields = [
        'code', 'name', 'nameKana', 'displayName', 'contractStatus', 'remarks'
      ];
      let allowedFields = [
        'code', 'name', 'nameKana', 'displayName', 'contractStatus', 'remarks',
        'tokenMap', 'uid', 'updatedAt'
      ];
      return isValidOutsourcer(request.resource.data, docId)
        && request.resource.data.docId == resource.data.docId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && changed.hasAny(businessFields)
        && changed.hasOnly(allowedFields)
        && (!changed.hasAny(['tokenMap'])
          || changed.hasAny(['name', 'nameKana', 'displayName']));
    }

    function isValidCustomerCreate(docId) {
      return isValidCustomer(request.resource.data, docId)
        && request.resource.data.contractStatus == 'ACTIVE'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidCustomerUpdate(docId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let basicFields = [
        'code', 'name', 'branchName', 'abbreviation', 'nameKana',
        'zipcode', 'prefCode', 'city', 'address', 'building',
        'tel', 'fax', 'contractStatus', 'remarks'
      ];
      let basicAndDerivedFields = [
        'code', 'name', 'branchName', 'abbreviation', 'nameKana',
        'zipcode', 'prefCode', 'city', 'address', 'building',
        'tel', 'fax', 'contractStatus', 'remarks', 'tokenMap', 'location', 'geopoint',
        'fullAddress', 'prefecture', 'uid', 'updatedAt'
      ];
      let paymentFields = ['cutoffDate', 'paymentMonth', 'paymentDate'];
      let paymentAndMetadataFields = [
        'cutoffDate', 'paymentMonth', 'paymentDate', 'uid', 'updatedAt'
      ];
      return isValidCustomer(request.resource.data, docId)
        && request.resource.data.docId == resource.data.docId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && (!changed.hasAny(['tokenMap'])
          || changed.hasAny(['name', 'nameKana']))
        && (!changed.hasAny([
              'location', 'geopoint', 'fullAddress', 'prefecture'
            ])
          || changed.hasAny(['prefCode', 'city', 'address']))
        && ((changed.hasAny(basicFields)
              && changed.hasOnly(basicAndDerivedFields))
          || (changed.hasAny(paymentFields)
              && changed.hasOnly(paymentAndMetadataFields)));
    }

    function isNullableTimestamp(value) {
      return value == null || value is timestamp;
    }

    function isValidSiteLocation(data) {
      return data.location == null
        ? (!data.keys().hasAny(['geopoint']) || data.geopoint == null)
        : (isValidCustomerLocation(data.location)
          && (!data.keys().hasAny(['geopoint'])
            || (data.geopoint is latlng
              && data.geopoint.latitude() == data.location.lat
              && data.geopoint.longitude() == data.location.lng)));
    }

    function isMatchingSitePrefecture(prefCode, prefecture) {
      return (prefCode + ':' + prefecture).matches(
        '^(01:北海道|02:青森県|03:岩手県|04:宮城県|05:秋田県|06:山形県|07:福島県|08:茨城県|09:栃木県|10:群馬県|11:埼玉県|12:千葉県|13:東京都|14:神奈川県|15:新潟県|16:富山県|17:石川県|18:福井県|19:山梨県|20:長野県|21:岐阜県|22:静岡県|23:愛知県|24:三重県|25:滋賀県|26:京都府|27:大阪府|28:兵庫県|29:奈良県|30:和歌山県|31:鳥取県|32:島根県|33:岡山県|34:広島県|35:山口県|36:徳島県|37:香川県|38:愛媛県|39:高知県|40:福岡県|41:佐賀県|42:長崎県|43:熊本県|44:大分県|45:宮崎県|46:鹿児島県|47:沖縄県)$'
      );
    }

    function isValidSiteDerivedFields(data) {
      return isRequiredString(data.fullAddress, 54)
        && isRequiredString(data.prefecture, 4)
        && data.fullAddress == data.prefecture + data.city + data.address
        && isMatchingSitePrefecture(data.prefCode, data.prefecture)
        && data.isTemporary is bool
        && data.isTemporary == (data.customerId == null)
        && data.hasConstructionPeriod is bool
        && data.hasConstructionPeriod == (data.constructionPeriodStartAt != null
          || data.constructionPeriodEndAt != null)
        && data.hasConstructionPeriodStartAt is bool
        && data.hasConstructionPeriodStartAt == (data.constructionPeriodStartAt != null)
        && data.hasConstructionPeriodEndAt is bool
        && data.hasConstructionPeriodEndAt == (data.constructionPeriodEndAt != null)
        && isRequiredString(data.displayName, 40)
        && data.displayName == (data.hasAbbreviation && data.abbreviation != null
          ? data.abbreviation
          : data.name)
        && isValidCustomerTokenMap(data.tokenMap);
    }

    function isValidSiteCore(data, docId) {
      return isRequiredString(data.docId, 128)
        && data.docId == docId
        && isRequiredString(data.uid, 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (data.customerId == null || isSafeCustomerId(data.customerId))
        && isNullableString(data.customerName, 20)
        && isNullableString(data.code, 10)
        && isRequiredString(data.name, 40)
        && data.hasAbbreviation is bool
        && isNullableString(data.abbreviation, 40)
        && (!data.hasAbbreviation || isRequiredString(data.abbreviation, 40))
        && isRequiredString(data.nameKana, 60)
        && (data.zipcode == null || data.zipcode is string)
        && data.prefCode is string
        && data.prefCode.matches('^(0[1-9]|[1-3][0-9]|4[0-7])$')
        && isRequiredString(data.city, 20)
        && isRequiredString(data.address, 30)
        && isNullableString(data.building, 30)
        && data.securityType in [
          'UNSET', 'FACILITY', 'CROWD', 'TRAFFIC', 'TRAINING', 'OTHER'
        ]
        && isNullableString(data.siteNumber, 40)
        && isNullableTimestamp(data.constructionPeriodStartAt)
        && isNullableTimestamp(data.constructionPeriodEndAt)
        && (data.constructionPeriodStartAt == null
          || data.constructionPeriodEndAt == null
          || data.constructionPeriodStartAt <= data.constructionPeriodEndAt)
        && isValidSiteLocation(data)
        && isNullableString(data.remarks, 200)
        && data.agreementsV2 is list
        && data.status in ['ACTIVE', 'TERMINATED']
        && isValidSiteDerivedFields(data);
    }

    function hasValidSiteCustomerCreate(companyId, data) {
      return data.customerId == null
        ? (data.customer == null && isRequiredString(data.customerName, 20))
        : (isSafeCustomerId(data.customerId)
          && hasCurrentSiteCustomerSnapshot(
            data.customer,
            get(/databases/$(database)/documents/Companies/$(companyId)/Customers/$(data.customerId)).data
          ));
    }

    function hasCurrentSiteCustomerSnapshot(snapshot, customer) {
      return snapshot is map
        && snapshot.keys().size() == 6
        && snapshot.keys().hasOnly([
          'docId', 'updatedAt', 'code', 'name', 'abbreviation', 'cutoffDate'
        ])
        && snapshot.docId == customer.docId
        && snapshot.updatedAt == customer.updatedAt
        && snapshot.code == customer.code
        && snapshot.name == customer.name
        && snapshot.abbreviation == customer.abbreviation
        && snapshot.cutoffDate == customer.cutoffDate;
    }

    function hasValidSiteCustomerUpdate(companyId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['customerId', 'customer'])
        ? request.resource.data.customer == resource.data.customer
        : (request.resource.data.customerId == null
          ? (resource.data.customerId == null
            && request.resource.data.customer == null
            && isRequiredString(request.resource.data.customerName, 20))
          : (isSafeCustomerId(request.resource.data.customerId)
            && hasCurrentSiteCustomerSnapshot(
              request.resource.data.customer,
              get(/databases/$(database)/documents/Companies/$(companyId)/Customers/$(request.resource.data.customerId)).data
            )));
    }

    function isValidSiteUpdateMetadata(data, docId) {
      return data.docId == docId
        && data.docId == resource.data.docId
        && data.createdAt == resource.data.createdAt
        && data.uid == request.auth.uid
        && data.updatedAt == request.time;
    }

    function isValidSiteBasicPatch(data, changed) {
      return (!changed.hasAny(['code']) || isNullableString(data.code, 10))
        && (!changed.hasAny(['name']) || isRequiredString(data.name, 40))
        && (!changed.hasAny(['hasAbbreviation']) || data.hasAbbreviation is bool)
        && (!changed.hasAny(['abbreviation']) || isNullableString(data.abbreviation, 40))
        && (!data.hasAbbreviation || isRequiredString(data.abbreviation, 40))
        && (!changed.hasAny(['nameKana']) || isRequiredString(data.nameKana, 60))
        && (!changed.hasAny(['zipcode'])
          || data.zipcode == null
          || data.zipcode is string)
        && (!changed.hasAny(['prefCode'])
          || (data.prefCode is string
            && data.prefCode.matches('^(0[1-9]|[1-3][0-9]|4[0-7])$')))
        && (!changed.hasAny(['city']) || isRequiredString(data.city, 20))
        && (!changed.hasAny(['address']) || isRequiredString(data.address, 30))
        && (!changed.hasAny(['building']) || isNullableString(data.building, 30))
        && (!changed.hasAny(['securityType'])
          || data.securityType in [
            'UNSET', 'FACILITY', 'CROWD', 'TRAFFIC', 'TRAINING', 'OTHER'
          ])
        && (!changed.hasAny(['siteNumber']) || isNullableString(data.siteNumber, 40))
        && (!changed.hasAny(['constructionPeriodStartAt'])
          || isNullableTimestamp(data.constructionPeriodStartAt))
        && (!changed.hasAny(['constructionPeriodEndAt'])
          || isNullableTimestamp(data.constructionPeriodEndAt))
        && (data.constructionPeriodStartAt == null
          || data.constructionPeriodEndAt == null
          || data.constructionPeriodStartAt <= data.constructionPeriodEndAt)
        && (!changed.hasAny(['remarks']) || isNullableString(data.remarks, 200));
    }

    function hasValidSiteBasicDerivedPatch(data, changed) {
      let tokenSourceChanged = changed.hasAny(['name', 'nameKana']);
      let displaySourceChanged = changed.hasAny([
        'name', 'hasAbbreviation', 'abbreviation'
      ]);
      let addressSourceChanged = changed.hasAny(['prefCode', 'city', 'address']);
      let constructionSourceChanged = changed.hasAny([
        'constructionPeriodStartAt', 'constructionPeriodEndAt'
      ]);
      return (!changed.hasAny(['tokenMap']) || tokenSourceChanged)
        && (!tokenSourceChanged
          || (changed.hasAny(['tokenMap'])
            && data.keys().hasAny(['tokenMap'])
            && isValidCustomerTokenMap(data.tokenMap)))
        && (!changed.hasAny(['displayName']) || displaySourceChanged)
        && (!displaySourceChanged
          || (data.keys().hasAny(['displayName'])
            && isRequiredString(data.displayName, 40)
            && data.displayName == (data.hasAbbreviation && data.abbreviation != null
              ? data.abbreviation
              : data.name)))
        && (!changed.hasAny(['location', 'geopoint', 'fullAddress', 'prefecture'])
          || addressSourceChanged)
        && (!addressSourceChanged
          || (data.keys().hasAll([
                'location', 'geopoint', 'fullAddress', 'prefecture'
              ])
            && isValidSiteLocation(data)
            && isRequiredString(data.prefecture, 4)
            && isMatchingSitePrefecture(data.prefCode, data.prefecture)
            && isRequiredString(data.fullAddress, 54)
            && data.fullAddress == data.prefecture + data.city + data.address))
        && (!changed.hasAny([
              'hasConstructionPeriod', 'hasConstructionPeriodStartAt',
              'hasConstructionPeriodEndAt'
            ])
          || constructionSourceChanged)
        && (!constructionSourceChanged
          || (data.keys().hasAll([
                'hasConstructionPeriod', 'hasConstructionPeriodStartAt',
                'hasConstructionPeriodEndAt'
              ])
            && data.hasConstructionPeriod is bool
            && data.hasConstructionPeriod == (data.constructionPeriodStartAt != null
              || data.constructionPeriodEndAt != null)
            && data.hasConstructionPeriodStartAt is bool
            && data.hasConstructionPeriodStartAt == (data.constructionPeriodStartAt != null)
            && data.hasConstructionPeriodEndAt is bool
            && data.hasConstructionPeriodEndAt == (data.constructionPeriodEndAt != null)));
    }

    function isValidSiteCreate(companyId, docId) {
      let data = request.resource.data;
      let keys = data.keys();
      return keys.hasOnly([
          'docId', 'uid', 'createdAt', 'updatedAt', 'customerId', 'customer',
          'customerName', 'code', 'name', 'hasAbbreviation', 'abbreviation',
          'nameKana', 'zipcode', 'prefCode', 'city', 'address', 'building',
          'securityType', 'siteNumber', 'constructionPeriodStartAt',
          'constructionPeriodEndAt', 'location', 'geopoint', 'remarks',
          'agreementsV2', 'status', 'fullAddress', 'prefecture', 'isTemporary',
          'hasConstructionPeriod', 'hasConstructionPeriodStartAt',
          'hasConstructionPeriodEndAt', 'displayName', 'tokenMap'
        ])
        && keys.size() == 34
        && isValidSiteCore(data, docId)
        && hasValidSiteCustomerCreate(companyId, data)
        && data.status == 'ACTIVE'
        && data.agreementsV2.size() == 0
        && data.uid == request.auth.uid
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidSiteUpdate(companyId, docId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let basicFields = [
        'code', 'name', 'hasAbbreviation', 'abbreviation', 'nameKana',
        'zipcode', 'prefCode', 'city', 'address', 'building', 'securityType',
        'siteNumber', 'constructionPeriodStartAt', 'constructionPeriodEndAt',
        'remarks'
      ];
      let basicAllowed = [
        'code', 'name', 'hasAbbreviation', 'abbreviation', 'nameKana',
        'zipcode', 'prefCode', 'city', 'address', 'building', 'securityType',
        'siteNumber', 'constructionPeriodStartAt', 'constructionPeriodEndAt',
        'remarks', 'customer', 'location', 'geopoint', 'fullAddress',
        'prefecture', 'hasConstructionPeriod', 'hasConstructionPeriodStartAt',
        'hasConstructionPeriodEndAt', 'displayName', 'tokenMap', 'uid', 'updatedAt'
      ];
      return isValidSiteUpdateMetadata(request.resource.data, docId)
        && ((changed.hasAny(basicFields)
            && changed.hasOnly(basicAllowed)
            && isValidSiteBasicPatch(request.resource.data, changed)
            && hasValidSiteBasicDerivedPatch(request.resource.data, changed)
            && hasValidSiteCustomerUpdate(companyId))
          || (changed.hasAny(['customerId'])
            && changed.hasOnly([
              'customerId', 'customer', 'isTemporary', 'uid', 'updatedAt'
            ])
            && (request.resource.data.customerId == null
              || isSafeCustomerId(request.resource.data.customerId))
            && request.resource.data.keys().hasAny(['isTemporary'])
            && request.resource.data.isTemporary is bool
            && request.resource.data.isTemporary == (request.resource.data.customerId == null)
            && hasValidSiteCustomerUpdate(companyId))
          || (changed.hasAny(['agreementsV2'])
            && changed.hasOnly(['agreementsV2', 'uid', 'updatedAt'])
            && request.resource.data.agreementsV2 is list));
    }

    // --- Rules for 'System' collection ---
    // System コレクション は未認証で読み取り可能。
    // 書き込みは SDK からのみ可能とする。
    match /System/system {
      allow read: if true;
      allow write: if false;
    }

    // Legacy admin_users is not an authorization source and is server-only.
    match /admin_users/{uid} {
      allow read, write: if false;
    }

    // --- Rules for 'FcmTokens' collection (Global Collection) ---
    // FcmTokens コレクションはグローバルコレクション（Companies配下ではない）
    // - 作成: 有効な本登録User本人がexact schemaでのみ作成可能
    // - 更新: owner移管を含め全面拒否。旧owner delete後に新ownerがcreateする
    // - 削除: 自分のuidのドキュメントのみ削除可能
    // - 読み取り: Cloud Functionsが管理者SDKで実行するため、クライアント側は不可
    match /FcmTokens/{token} {
      allow create: if isValidFcmTokenCreate(token);
      allow update: if false;
      allow delete: if hasValidIdentityClaims()
                    && resource.data.keys().hasOnly([
                      'token', 'uid', 'companyId', 'updatedAt'
                    ])
                    && resource.data.uid is string
                    && resource.data.uid == request.auth.uid
                    && resource.data.companyId is string
                    && resource.data.companyId == request.auth.token.companyId;
      allow read: if false; // Cloud Functions only
    }

    // User email reservations are owned exclusively by Cloud Functions/Admin SDK.
    match /UserEmailReservations/{document=**} {
      allow read, write: if false;
    }

    // --- Rules for 'Companies' collection ---
    // Company rootは同一tenantの有効な本登録Userだけが読み取り可能。
    // client writeは全面拒否し、正規更新はCloud Functions/Admin SDKに限定する。
    match /Companies/{companyDocId} {
      allow read: if isAuthenticated() && userCompanyId() == companyDocId;
      allow create, update, delete: if false;
    }

    // --- Rules for 'ArrangementNotifications' subcollection under 'Companies' ---
    // ArrangementNotificationsコレクションはCompaniesコレクションのサブコレクション。
    // 認証ユーザーの companyId と一致する Companies ドキュメント配下の
    // ArrangementNotifications ドキュメントのみ Read/Write を許可。
    match /Companies/{companyId}/ArrangementNotifications/{id} {
      allow read, write: if isAuthenticated() && userCompanyId() == companyId;
    }

    // --- Rules for 'Articles' subcollection under 'Companies' ---
    // ArticlesコレクションはCompaniesコレクションのサブコレクション。
    // 認証ユーザーの companyId と一致する Companies ドキュメント配下の
    // Articles ドキュメントのみ Read/Write を許可。
    match /Companies/{companyId}/Articles/{docId} {
      allow read, write: if isAuthenticated() && userCompanyId() == companyId;
    }

    // --- Rules for 'Articles_archive' subcollection under 'Companies' ---
    // Articles_archiveコレクションはCompaniesコレクションのサブコレクション。
    // 認証ユーザーの companyId と一致する Companies ドキュメント配下の
    // Articles_archive ドキュメントのみ Read/Write を許可。
    match /Companies/{companyId}/Articles_archive/{docId} {
      allow read, write: if isAuthenticated() && userCompanyId() == companyId;
    }

    // --- Rules for 'Autonumbers' subcollection under 'Companies' ---
    // AutonumbersコレクションはCompaniesコレクションのサブコレクション。
    // 認証ユーザーの companyId と一致する Companies ドキュメント配下の
    // Autonumbers ドキュメントのみ Read/Write を許可。
    match /Companies/{companyId}/Autonumbers/{id} {
      allow read, write: if isAuthenticated() && userCompanyId() == companyId;
    }

    // --- Rules for 'Billings' subcollection under 'Companies' ---
    // 同一tenant境界を維持し、customerIdの作成・変更時だけ参照先Customerを検証する。
    match /Companies/{companyId}/Billings/{docId} {
      allow read: if isAuthenticated() && userCompanyId() == companyId;
      allow create: if isAuthenticated()
                    && userCompanyId() == companyId
                    && isValidCustomerReferenceCreate(companyId);
      allow update: if isAuthenticated()
                    && userCompanyId() == companyId
                    && isValidCustomerReferenceUpdate(companyId);
      allow delete: if isAuthenticated() && userCompanyId() == companyId;
    }

    // --- Rules for 'Customers' subcollection under 'Companies' ---
    // 読み取りは既存の同一tenant境界を維持する。
    // 作成・更新は有効な会社管理者または既知preset由来の担当者に限定し、
    // exact schemaとoperation別の変更field、同ID archive不存在を検証する。
    // 削除はclientへ許可しない。
    match /Companies/{companyId}/Customers/{docId} {
      allow read: if isAuthenticated() && userCompanyId() == companyId;
      allow create: if canWriteCustomer(companyId)
                    && isValidCustomerCreate(docId)
                    && !exists(/databases/$(database)/documents/Companies/$(companyId)/Customers_archive/$(docId));
      allow update: if canWriteCustomer(companyId)
                    && isValidCustomerUpdate(docId);
      allow delete: if false;
    }

    // --- Rules for 'Customers_archive' subcollection under 'Companies' ---
    // archiveはroot documentとnested pathを含めclientへ公開しない。
    match /Companies/{companyId}/Customers_archive/{document=**} {
      allow read, write: if false;
    }

    // --- Rules for 'Employees' subcollection under 'Companies' ---
    // EmployeesコレクションはCompaniesコレクションのサブコレクション。
    // 認証ユーザーの companyId と一致する Companies ドキュメント配下の
    // Employees ドキュメントのみ Read/Write を許可。
    match /Companies/{companyId}/Employees/{docId} {
      allow read: if isAuthenticated() && userCompanyId() == companyId;
      allow create: if isAuthenticated()
                    && userCompanyId() == companyId
                    && isValidActiveEmployeeCreate();
      allow update: if isAuthenticated()
                    && userCompanyId() == companyId
                    && preservesEmployeeLifecycleFields();
      allow delete: if false;
    }

    // --- Rules for 'Employees_archive' subcollection under 'Companies' ---
    // Employees_archiveコレクションはCompaniesコレクションのサブコレクション。
    // 認証ユーザーの companyId と一致する Companies ドキュメント配下の
    // Employees_archive ドキュメントのみ Read/Write を許可。
    match /Companies/{companyId}/Employees_archive/{docId} {
      allow read, write: if isAuthenticated() && userCompanyId() == companyId;
    }

    // --- Rules for 'mets' subcollection under 'Companies' ---
    // metaコレクションはCompaniesコレクションのサブコレクション。
    // 認証ユーザーの companyId と一致する Companies ドキュメント配下の
    // meta ドキュメントのみ Read/Write を許可。
    match /Companies/{companyId}/meta/{docId} {
      allow read, write: if isAuthenticated() && userCompanyId() == companyId;
    }

    // --- Rules for 'OperationResults' subcollection under 'Companies' ---
    // 同一tenant境界を維持し、customerIdの作成・変更時だけ参照先Customerを検証する。
    match /Companies/{companyId}/OperationResults/{docId} {
      allow read: if isAuthenticated() && userCompanyId() == companyId;
      allow create: if isAuthenticated()
                    && userCompanyId() == companyId
                    && isValidCustomerReferenceCreate(companyId);
      allow update: if isAuthenticated()
                    && userCompanyId() == companyId
                    && isValidCustomerReferenceUpdate(companyId);
      allow delete: if isAuthenticated() && userCompanyId() == companyId;
    }

    // --- Rules for 'SecurityReportIndexes' subcollection under 'Companies' ---
    // SecurityReportIndexesコレクションは、Storageに保存されている警備日報の
    // 検索用インデックスとしてCloud Functionsが管理する。
    // - 読み取り: 同じ会社の有効な本登録ユーザーのみ許可。
    // - 書き込み: Admin SDKを使用するCloud Functionsのみに限定し、
    //   クライアントからの作成・更新・削除は許可しない。
    match /Companies/{companyId}/SecurityReportIndexes/{docId} {
      allow read: if isAuthenticated() && userCompanyId() == companyId;
      allow write: if false;
    }

    // --- Rules for 'Outsourcers' subcollection under 'Companies' ---
    // OutsourcersコレクションはCompaniesコレクションのサブコレクション。
    // 認証ユーザーの companyId と一致する Companies ドキュメント配下の
    // 読取りは同一tenantに維持し、作成・更新は会社管理者または
    // non-super-userのexact manager presetだけに許可する。削除は拒否する。
    match /Companies/{companyId}/Outsourcers/{docId} {
      allow read: if isAuthenticated() && userCompanyId() == companyId;
      allow create: if canWriteOutsourcer(companyId)
                    && isValidOutsourcerCreate(docId);
      allow update: if canWriteOutsourcer(companyId)
                    && isValidOutsourcerUpdate(docId);
      allow delete: if false;
    }

    // --- Rules for 'Outsourcers_archive' subcollection under 'Companies' ---
    // Outsourcers_archiveコレクションはCompaniesコレクションのサブコレクション。
    // 認証ユーザーの companyId と一致する Companies ドキュメント配下の
    // archiveの読取りは同一tenantに維持し、client writeは全て拒否する。
    match /Companies/{companyId}/Outsourcers_archive/{docId} {
      allow read: if isAuthenticated() && userCompanyId() == companyId;
      allow write: if false;
    }

    // --- Rules for 'Sites' subcollection under 'Companies' ---
    // 読取りは既存の同一tenant境界を維持する。作成・更新は有効な
    // 会社管理者またはnon-super-userの既知preset由来sites:writeへ限定する。
    // customerIdなしの仮Siteを許可し、設定後のunsetは拒否する。
    match /Companies/{companyId}/Sites/{docId} {
      allow read: if isAuthenticated() && userCompanyId() == companyId;
      allow create: if canWriteSite(companyId)
                    && isValidSiteCreate(companyId, docId);
      allow update: if canWriteSite(companyId)
                    && isValidSiteUpdate(companyId, docId);
      allow delete: if false;
    }

    // --- Rules for 'Sites_archive' subcollection under 'Companies' ---
    // archiveの読取りは同一tenantに維持し、client writeは全て拒否する。
    match /Companies/{companyId}/Sites_archive/{docId} {
      allow read: if isAuthenticated() && userCompanyId() == companyId;
      allow write: if false;
    }

    // --- Rules for 'SiteOperationSchedules' subcollection under 'Companies' ---
    // SiteOperationSchedulesコレクションはCompaniesコレクションのサブコレクション。
    // 認証ユーザーの companyId と一致する Companies ドキュメント配下の
    // SiteOperationSchedules ドキュメントのみ Read/Write を許可。
    match /Companies/{companyId}/SiteOperationSchedules/{docId} {
      allow read, write: if isAuthenticated() && userCompanyId() == companyId;
    }

    // Legacy StripeData is reserved and server-only at every nesting depth.
    match /Companies/{companyId}/StripeData/{document=**} {
      allow read, write: if false;
    }

    // --- Rules for 'Users' subcollection under 'Companies' ---
    // UsersコレクションはCompaniesコレクションのサブコレクション。
    // 認証ユーザーの companyId と一致する Companies ドキュメント配下の
    // Users ドキュメントのみ Read/Write を許可。
    match /Companies/{companyId}/Users/{userId} {
      allow read: if isAuthenticated() && userCompanyId() == companyId;
      allow create, update, delete: if false;
    }

    // Employee/User link reservations are owned exclusively by Cloud Functions/Admin SDK.
    match /Companies/{companyId}/EmployeeUserReservations/{document=**} {
      allow read, write: if false;
    }

    // Lifecycle ledger, events, locks, and Employee heads are server-only.
    match /Companies/{companyId}/LifecycleOperations/{document=**} {
      allow read, write: if false;
    }
    match /Companies/{companyId}/UserLifecycleLocks/{document=**} {
      allow read, write: if false;
    }
    match /Companies/{companyId}/EmployeeLifecycleLocks/{document=**} {
      allow read, write: if false;
    }
    match /Companies/{companyId}/EmployeeLifecycleHeads/{document=**} {
      allow read, write: if false;
    }

    // Companies配下の未定義パスにも同じtenant identity gateを適用する。
    // 個別操作制約を持つcollectionを迂回しないよう除外する。
    match /Companies/{companyId}/{collection}/{document=**} {
      allow read, write: if !(collection in [
                                "SecurityReportIndexes",
                                "StripeData",
                                "Billings",
                                "Customers",
                                "Customers_archive",
                                "OperationResults",
                                "Outsourcers",
                                "Outsourcers_archive",
                                "Sites",
                                "Sites_archive",
                                "Users",
                                "Employees",
                                "EmployeeUserReservations",
                                "LifecycleOperations",
                                "UserLifecycleLocks",
                                "EmployeeLifecycleLocks",
                                "EmployeeLifecycleHeads"
                              ])
                              && isAuthenticated()
                              && userCompanyId() == companyId;
    }
  }
}
