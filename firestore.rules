rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions (Optional, but good for clarity) ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasValidIdentityClaims() {
      return isAuthenticated()
        && request.auth.token.email_verified is bool
        && request.auth.token.email_verified == true
        && request.auth.token.companyId is string
        && request.auth.token.companyId.size() > 0;
    }

    function hasActiveRegisteredUser() {
      return hasValidIdentityClaims()
        && exists(/databases/$(database)/documents/Companies/$(request.auth.token.companyId)/Users/$(request.auth.uid))
        && get(/databases/$(database)/documents/Companies/$(request.auth.token.companyId)/Users/$(request.auth.uid)).data.companyId is string
        && get(/databases/$(database)/documents/Companies/$(request.auth.token.companyId)/Users/$(request.auth.uid)).data.companyId == request.auth.token.companyId
        && get(/databases/$(database)/documents/Companies/$(request.auth.token.companyId)/Users/$(request.auth.uid)).data.isTemporary is bool
        && get(/databases/$(database)/documents/Companies/$(request.auth.token.companyId)/Users/$(request.auth.uid)).data.isTemporary == false
        && get(/databases/$(database)/documents/Companies/$(request.auth.token.companyId)/Users/$(request.auth.uid)).data.disabled is bool
        && get(/databases/$(database)/documents/Companies/$(request.auth.token.companyId)/Users/$(request.auth.uid)).data.disabled == false;
    }

    function userCompanyId() {
      return hasActiveRegisteredUser()
        ? request.auth.token.companyId
        : "";
    }

    function isSafeIdentifier(value) {
      return value is string && value.size() > 0 && value.size() <= 128;
    }

    function isValidFcmTokenCreate(token) {
      return hasActiveRegisteredUser()
        && request.resource.data.keys().hasOnly([
          'token', 'uid', 'companyId', 'updatedAt'
        ])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.token.size() <= 4096
        && request.resource.data.token == token
        && isSafeIdentifier(request.resource.data.uid)
        && request.resource.data.uid == request.auth.uid
        && isSafeIdentifier(request.resource.data.companyId)
        && request.resource.data.companyId == request.auth.token.companyId
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidActiveEmployeeCreate() {
      return request.resource.data.employmentStatus is string
        && request.resource.data.employmentStatus == 'ACTIVE'
        && (!request.resource.data.keys().hasAny(['dateOfTermination'])
          || request.resource.data.dateOfTermination == null)
        && (!request.resource.data.keys().hasAny(['reasonOfTermination'])
          || request.resource.data.reasonOfTermination == null);
    }

    function preservesEmployeeLifecycleFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'employmentStatus', 'dateOfTermination', 'reasonOfTermination'
      ]);
    }

    function isNullableString(value, maxSize) {
      return value == null || (value is string && value.size() <= maxSize);
    }

    function isRequiredString(value, maxSize) {
      return value is string && value.size() > 0 && value.size() <= maxSize;
    }

    function isValidCustomerLocation(value) {
      return value == null
        || (value is map
          && value.keys().hasAll(['formattedAddress', 'lat', 'lng'])
          && value.keys().hasOnly(['formattedAddress', 'lat', 'lng'])
          && isRequiredString(value.formattedAddress, 200)
          && value.lat is number
          && value.lat >= -90
          && value.lat <= 90
          && value.lng is number
          && value.lng >= -180
          && value.lng <= 180);
    }

    function isValidCustomerTokenMap(value) {
      return value == null
        || (value is map
          && value.size() <= 512
          && value.values().hasOnly([true]));
    }

    function isValidCustomer(data, docId) {
      return data.keys().size() == 26
        && isRequiredString(data.docId, 128)
        && data.docId == docId
        && isRequiredString(data.uid, 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && isNullableString(data.code, 10)
        && isRequiredString(data.name, 20)
        && isNullableString(data.branchName, 20)
        && isRequiredString(data.abbreviation, 20)
        && isRequiredString(data.nameKana, 40)
        && data.zipcode is string
        && data.zipcode.size() > 0
        && data.prefCode is string
        && data.prefCode.matches('^(0[1-9]|[1-3][0-9]|4[0-7])$')
        && isRequiredString(data.city, 20)
        && isRequiredString(data.address, 30)
        && isNullableString(data.building, 30)
        && isValidCustomerLocation(data.location)
        && ((data.location == null && data.geopoint == null)
          || (data.location is map
            && data.geopoint is latlng
            && data.geopoint.latitude() == data.location.lat
            && data.geopoint.longitude() == data.location.lng))
        && isNullableString(data.tel, 13)
        && isNullableString(data.fax, 13)
        && data.contractStatus in ['ACTIVE', 'TERMINATED']
        && data.cutoffDate is int
        && data.cutoffDate in [0, 5, 10, 15, 20, 25]
        && data.paymentMonth is int
        && data.paymentMonth in [0, 1, 2, 3, 4, 5, 6]
        && data.paymentDate is int
        && data.paymentDate in [0, 5, 10, 15, 20, 25]
        && isNullableString(data.remarks, 200)
        && isRequiredString(data.fullAddress, 74)
        && isRequiredString(data.prefecture, 4)
        && data.fullAddress == data.prefecture + data.city + data.address
        && isValidCustomerTokenMap(data.tokenMap);
    }

    function hasCustomerWriteRole(user) {
      return user.roles is list
        && user.roles.size() <= 6
        && user.roles.hasOnly([
          'manager', 'controller', 'accountant',
          'human-resource', 'labor', 'legal'
        ])
        && user.roles.hasAny(['manager', 'legal']);
    }

    function canWriteCustomer(companyId) {
      let user = get(/databases/$(database)/documents/Companies/$(companyId)/Users/$(request.auth.uid)).data;
      return hasValidIdentityClaims()
        && request.auth.token.companyId == companyId
        && exists(/databases/$(database)/documents/Companies/$(companyId)/Users/$(request.auth.uid))
        && user.companyId is string
        && user.companyId == companyId
        && user.isTemporary is bool
        && user.isTemporary == false
        && user.disabled is bool
        && user.disabled == false
        && request.auth.token.isSuperUser is bool
        && user.isAdmin is bool
        && (user.isAdmin == true
          || (request.auth.token.isSuperUser == false
            && hasCustomerWriteRole(user)));
    }

    function isValidCustomerCreate(docId) {
      return isValidCustomer(request.resource.data, docId)
        && request.resource.data.contractStatus == 'ACTIVE'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidCustomerUpdate(docId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let basicFields = [
        'code', 'name', 'branchName', 'abbreviation', 'nameKana',
        'zipcode', 'prefCode', 'city', 'address', 'building',
        'tel', 'fax', 'remarks'
      ];
      let basicAndDerivedFields = [
        'code', 'name', 'branchName', 'abbreviation', 'nameKana',
        'zipcode', 'prefCode', 'city', 'address', 'building',
        'tel', 'fax', 'remarks', 'tokenMap', 'location', 'geopoint',
        'fullAddress', 'prefecture', 'uid', 'updatedAt'
      ];
      let paymentFields = ['cutoffDate', 'paymentMonth', 'paymentDate'];
      let paymentAndMetadataFields = [
        'cutoffDate', 'paymentMonth', 'paymentDate', 'uid', 'updatedAt'
      ];
      return isValidCustomer(request.resource.data, docId)
        && request.resource.data.docId == resource.data.docId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.contractStatus == resource.data.contractStatus
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && (!changed.hasAny(['tokenMap'])
          || changed.hasAny(['name', 'nameKana']))
        && (!changed.hasAny([
              'location', 'geopoint', 'fullAddress', 'prefecture'
            ])
          || changed.hasAny(['prefCode', 'city', 'address']))
        && ((changed.hasAny(basicFields)
              && changed.hasOnly(basicAndDerivedFields))
          || (changed.hasAny(paymentFields)
              && changed.hasOnly(paymentAndMetadataFields)));
    }

    // --- Rules for 'System' collection ---
    // System コレクション は未認証で読み取り可能。
    // 書き込みは SDK からのみ可能とする。
    match /System/system {
      allow read: if true;
      allow write: if false;
    }

    // Legacy admin_users is not an authorization source and is server-only.
    match /admin_users/{uid} {
      allow read, write: if false;
    }

    // --- Rules for 'FcmTokens' collection (Global Collection) ---
    // FcmTokens コレクションはグローバルコレクション（Companies配下ではない）
    // - 作成: 有効な本登録User本人がexact schemaでのみ作成可能
    // - 更新: owner移管を含め全面拒否。旧owner delete後に新ownerがcreateする
    // - 削除: 自分のuidのドキュメントのみ削除可能
    // - 読み取り: Cloud Functionsが管理者SDKで実行するため、クライアント側は不可
    match /FcmTokens/{token} {
      allow create: if isValidFcmTokenCreate(token);
      allow update: if false;
      allow delete: if hasValidIdentityClaims()
                    && resource.data.keys().hasOnly([
                      'token', 'uid', 'companyId', 'updatedAt'
                    ])
                    && resource.data.uid is string
                    && resource.data.uid == request.auth.uid
                    && resource.data.companyId is string
                    && resource.data.companyId == request.auth.token.companyId;
      allow read: if false; // Cloud Functions only
    }

    // User email reservations are owned exclusively by Cloud Functions/Admin SDK.
    match /UserEmailReservations/{document=**} {
      allow read, write: if false;
    }

    // --- Rules for 'Companies' collection ---
    // Company rootは同一tenantの有効な本登録Userだけが読み取り可能。
    // client writeは全面拒否し、正規更新はCloud Functions/Admin SDKに限定する。
    match /Companies/{companyDocId} {
      allow read: if isAuthenticated() && userCompanyId() == companyDocId;
      allow create, update, delete: if false;
    }

    // --- Rules for 'ArrangementNotifications' subcollection under 'Companies' ---
    // ArrangementNotificationsコレクションはCompaniesコレクションのサブコレクション。
    // 認証ユーザーの companyId と一致する Companies ドキュメント配下の
    // ArrangementNotifications ドキュメントのみ Read/Write を許可。
    match /Companies/{companyId}/ArrangementNotifications/{id} {
      allow read, write: if isAuthenticated() && userCompanyId() == companyId;
    }

    // --- Rules for 'Articles' subcollection under 'Companies' ---
    // ArticlesコレクションはCompaniesコレクションのサブコレクション。
    // 認証ユーザーの companyId と一致する Companies ドキュメント配下の
    // Articles ドキュメントのみ Read/Write を許可。
    match /Companies/{companyId}/Articles/{docId} {
      allow read, write: if isAuthenticated() && userCompanyId() == companyId;
    }

    // --- Rules for 'Articles_archive' subcollection under 'Companies' ---
    // Articles_archiveコレクションはCompaniesコレクションのサブコレクション。
    // 認証ユーザーの companyId と一致する Companies ドキュメント配下の
    // Articles_archive ドキュメントのみ Read/Write を許可。
    match /Companies/{companyId}/Articles_archive/{docId} {
      allow read, write: if isAuthenticated() && userCompanyId() == companyId;
    }

    // --- Rules for 'Autonumbers' subcollection under 'Companies' ---
    // AutonumbersコレクションはCompaniesコレクションのサブコレクション。
    // 認証ユーザーの companyId と一致する Companies ドキュメント配下の
    // Autonumbers ドキュメントのみ Read/Write を許可。
    match /Companies/{companyId}/Autonumbers/{id} {
      allow read, write: if isAuthenticated() && userCompanyId() == companyId;
    }

    // --- Rules for 'Billings' subcollection under 'Companies' ---
    // BillingsコレクションはCompaniesコレクションのサブコレクション。
    // 認証ユーザーの companyId と一致する Companies ドキュメント配下の
    // Billings ドキュメントのみ Read/Write を許可。
    match /Companies/{companyId}/Billings/{docId} {
      allow read, write: if isAuthenticated() && userCompanyId() == companyId;
    }

    // --- Rules for 'Customers' subcollection under 'Companies' ---
    // 読み取りは既存の同一tenant境界を維持する。
    // 作成・更新は有効な会社管理者または既知preset由来の担当者に限定し、
    // exact schemaとoperation別の変更fieldを検証する。削除はclientへ許可しない。
    match /Companies/{companyId}/Customers/{docId} {
      allow read: if isAuthenticated() && userCompanyId() == companyId;
      allow create: if canWriteCustomer(companyId)
                    && isValidCustomerCreate(docId);
      allow update: if canWriteCustomer(companyId)
                    && isValidCustomerUpdate(docId);
      allow delete: if false;
    }

    // --- Rules for 'Customers_archive' subcollection under 'Companies' ---
    // archiveの読み取りは既存境界を維持し、client CUDは全面拒否する。
    match /Companies/{companyId}/Customers_archive/{docId} {
      allow read: if isAuthenticated() && userCompanyId() == companyId;
      allow create, update, delete: if false;
    }

    // --- Rules for 'Employees' subcollection under 'Companies' ---
    // EmployeesコレクションはCompaniesコレクションのサブコレクション。
    // 認証ユーザーの companyId と一致する Companies ドキュメント配下の
    // Employees ドキュメントのみ Read/Write を許可。
    match /Companies/{companyId}/Employees/{docId} {
      allow read: if isAuthenticated() && userCompanyId() == companyId;
      allow create: if isAuthenticated()
                    && userCompanyId() == companyId
                    && isValidActiveEmployeeCreate();
      allow update: if isAuthenticated()
                    && userCompanyId() == companyId
                    && preservesEmployeeLifecycleFields();
      allow delete: if false;
    }

    // --- Rules for 'Employees_archive' subcollection under 'Companies' ---
    // Employees_archiveコレクションはCompaniesコレクションのサブコレクション。
    // 認証ユーザーの companyId と一致する Companies ドキュメント配下の
    // Employees_archive ドキュメントのみ Read/Write を許可。
    match /Companies/{companyId}/Employees_archive/{docId} {
      allow read, write: if isAuthenticated() && userCompanyId() == companyId;
    }

    // --- Rules for 'mets' subcollection under 'Companies' ---
    // metaコレクションはCompaniesコレクションのサブコレクション。
    // 認証ユーザーの companyId と一致する Companies ドキュメント配下の
    // meta ドキュメントのみ Read/Write を許可。
    match /Companies/{companyId}/meta/{docId} {
      allow read, write: if isAuthenticated() && userCompanyId() == companyId;
    }

    // --- Rules for 'OperationResults' subcollection under 'Companies' ---
    // OperationResultsコレクションはCompaniesコレクションのサブコレクション。
    // 認証ユーザーの companyId と一致する Companies ドキュメント配下の
    // OperationResults ドキュメントのみ Read/Write を許可。
    match /Companies/{companyId}/OperationResults/{docId} {
      allow read, write: if isAuthenticated() && userCompanyId() == companyId;
    }

    // --- Rules for 'SecurityReportIndexes' subcollection under 'Companies' ---
    // SecurityReportIndexesコレクションは、Storageに保存されている警備日報の
    // 検索用インデックスとしてCloud Functionsが管理する。
    // - 読み取り: 同じ会社の有効な本登録ユーザーのみ許可。
    // - 書き込み: Admin SDKを使用するCloud Functionsのみに限定し、
    //   クライアントからの作成・更新・削除は許可しない。
    match /Companies/{companyId}/SecurityReportIndexes/{docId} {
      allow read: if isAuthenticated() && userCompanyId() == companyId;
      allow write: if false;
    }

    // --- Rules for 'Outsourcers' subcollection under 'Companies' ---
    // OutsourcersコレクションはCompaniesコレクションのサブコレクション。
    // 認証ユーザーの companyId と一致する Companies ドキュメント配下の
    // Outsourcers ドキュメントのみ Read/Write を許可。
    match /Companies/{companyId}/Outsourcers/{docId} {
      allow read, write: if isAuthenticated() && userCompanyId() == companyId;
    }

    // --- Rules for 'Outsourcers_archive' subcollection under 'Companies' ---
    // Outsourcers_archiveコレクションはCompaniesコレクションのサブコレクション。
    // 認証ユーザーの companyId と一致する Companies ドキュメント配下の
    // Outsourcers ドキュメントのみ Read/Write を許可。
    match /Companies/{companyId}/Outsourcers_archive/{docId} {
      allow read, write: if isAuthenticated() && userCompanyId() == companyId;
    }

    // --- Rules for 'Sites' subcollection under 'Companies' ---
    // SitesコレクションはCompaniesコレクションのサブコレクション。
    // 認証ユーザーの companyId と一致する Companies ドキュメント配下の
    // Sites ドキュメントのみ Read/Write を許可。
    match /Companies/{companyId}/Sites/{docId} {
      allow read, write: if isAuthenticated() && userCompanyId() == companyId;
    }

    // --- Rules for 'Sites_archive' subcollection under 'Companies' ---
    // Sites_archiveコレクションはCompaniesコレクションのサブコレクション。
    // 認証ユーザーの companyId と一致する Companies ドキュメント配下の
    // Sites_archive ドキュメントのみ Read/Write を許可。
    match /Companies/{companyId}/Sites_archive/{docId} {
      allow read, write: if isAuthenticated() && userCompanyId() == companyId;
    }

    // --- Rules for 'SiteOperationSchedules' subcollection under 'Companies' ---
    // SiteOperationSchedulesコレクションはCompaniesコレクションのサブコレクション。
    // 認証ユーザーの companyId と一致する Companies ドキュメント配下の
    // SiteOperationSchedules ドキュメントのみ Read/Write を許可。
    match /Companies/{companyId}/SiteOperationSchedules/{docId} {
      allow read, write: if isAuthenticated() && userCompanyId() == companyId;
    }

    // Legacy StripeData is reserved and server-only at every nesting depth.
    match /Companies/{companyId}/StripeData/{document=**} {
      allow read, write: if false;
    }

    // --- Rules for 'Users' subcollection under 'Companies' ---
    // UsersコレクションはCompaniesコレクションのサブコレクション。
    // 認証ユーザーの companyId と一致する Companies ドキュメント配下の
    // Users ドキュメントのみ Read/Write を許可。
    match /Companies/{companyId}/Users/{userId} {
      allow read: if isAuthenticated() && userCompanyId() == companyId;
      allow create, update, delete: if false;
    }

    // Employee/User link reservations are owned exclusively by Cloud Functions/Admin SDK.
    match /Companies/{companyId}/EmployeeUserReservations/{document=**} {
      allow read, write: if false;
    }

    // Lifecycle ledger, events, locks, and Employee heads are server-only.
    match /Companies/{companyId}/LifecycleOperations/{document=**} {
      allow read, write: if false;
    }
    match /Companies/{companyId}/UserLifecycleLocks/{document=**} {
      allow read, write: if false;
    }
    match /Companies/{companyId}/EmployeeLifecycleLocks/{document=**} {
      allow read, write: if false;
    }
    match /Companies/{companyId}/EmployeeLifecycleHeads/{document=**} {
      allow read, write: if false;
    }

    // Companies配下の未定義パスにも同じtenant identity gateを適用する。
    // 個別操作制約を持つcollectionを迂回しないよう除外する。
    match /Companies/{companyId}/{collection}/{document=**} {
      allow read, write: if !(collection in [
                                "SecurityReportIndexes",
                                "StripeData",
                                "Customers",
                                "Customers_archive",
                                "Users",
                                "Employees",
                                "EmployeeUserReservations",
                                "LifecycleOperations",
                                "UserLifecycleLocks",
                                "EmployeeLifecycleLocks",
                                "EmployeeLifecycleHeads"
                              ])
                              && isAuthenticated()
                              && userCompanyId() == companyId;
    }
  }
}
